$fn = 64;

// --- параметры ---
stem_d   = 4.3;   // диаметр штока
stem_h   = 6;     // длина штока (от шайбы до верха)
flange_d = 6;     // диаметр шайбы
flange_h = 1;     // толщина шайбы

// -----------------------------------------------

union() {
    cylinder(h = stem_h, d = stem_d);
    cylinder(h = flange_h, d = flange_d);
}